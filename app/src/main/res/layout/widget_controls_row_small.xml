<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_controls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_btn_prev"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_prev_desc"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_previous" />

    <ImageView
        android:id="@+id/widget_btn_play"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_play_pause_desc"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/iv_play" />

    <ImageView
        android:id="@+id/widget_btn_next"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_next_desc"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_next" />
</LinearLayout>
