<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- DataStore contains session credentials and playback/chat preferences. -->
    <exclude domain="file" path="datastore/" />
    <!-- Offline music files without Room metadata would restore as orphans. -->
    <exclude domain="file" path="downloads/" />
    <!-- Local database can contain conversations and downloaded-media metadata. -->
    <exclude domain="database" path="." />
</full-backup-content>